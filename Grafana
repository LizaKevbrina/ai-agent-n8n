          }
        ]
      },
      {
        "title": "LLM Queue Size",
        "targets": [
          {
            "expr": "llm_queue_size"
          }
        ]
      },
      {
        "title": "Token Usage",
        "targets": [
          {
            "expr": "rate(llm_tokens_used_sum[5m])"
          }
        ]
      },
      {
        "title": "Cache Hit Rate",
        "targets": [
          {
            "expr": "sum(rate(rag_cache_hits_total[5m])) / (sum(rate(rag_cache_hits_total[5m])) + sum(rate(rag_cache_misses_total[5m])))"
          }
        ]
      },
      {
        "title": "Memory Version Conflicts",
        "targets": [
          {
            "expr": "rate(memory_version_conflicts_total[5m])"
